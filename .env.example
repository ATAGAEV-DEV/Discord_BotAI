# =================================================================
# Пример файла переменных окружения для Discord Bot AI
# Скопируйте этот файл в .env и замените значения-заглушки своими.
# Не публикуйте файл .env и не добавляйте его в репозиторий.
# =================================================================

# -----------------------------------------------------------------
# Discord
# -----------------------------------------------------------------
# Токен бота из Discord Developer Portal.
DC_TOKEN=your_discord_token_here

# -----------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------
# Строка подключения к PostgreSQL через драйвер asyncpg.
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:pass@localhost:5432/discord
# Имя схемы PostgreSQL. При пустом значении используется схема по умолчанию
# для базы данных, обычно public.
DATABASE_SCHEMA=discord

# -----------------------------------------------------------------
# AI API: чат
# -----------------------------------------------------------------
# Имя провайдера для chat-моделей. Для текущей конфигурации оставьте polza.
AI_PROVIDER=polza
# URL API для chat-моделей.
AI_API_URL=https://api.polza.ai/api/v1
# Основная chat-модель. Она должна быть доступна у выбранного провайдера.
AI_MODEL=claude-haiku-4.5
# Дополнительная облегчённая модель. Она также должна быть доступна у провайдера.
AI_MODEL_MINI=gpt-5-mini
# API-ключ для chat-моделей.
AI_TOKEN=your_chat_polza_token_here

# -----------------------------------------------------------------
# Embeddings: векторные представления для памяти бота
# -----------------------------------------------------------------
# Имя провайдера для embeddings. Для текущей конфигурации оставьте polza.
AI_EMBEDDING_PROVIDER=polza
# URL API для embedding-модели. Может отличаться от AI_API_URL.
AI_EMBEDDING_API_URL=https://api.polza.ai/api/v1
# Embedding-модель. Не меняйте её, если выбранный провайдер её поддерживает.
AI_EMBEDDING_MODEL=text-embedding-3-large
# API-ключ для embeddings. Может совпадать с AI_TOKEN при использовании одного провайдера.
AI_EMBEDDING_TOKEN=your_embedding_polza_token_here
