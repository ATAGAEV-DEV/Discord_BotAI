# =================================================================
# ТЕМПЛЕЙТ .ENV ФАЙЛА ДЛЯ DISCORD BOT AI
# =================================================================

# --- 1. CORE (ОБЯЗАТЕЛЬНО) ---
# Токен вашего бота из Discord Developer Portal
DC_TOKEN=your_discord_token_here
# Строка подключения к PostgreSQL (используйте драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:pass@localhost:5432/discord

# --- 2. AI CONFIGURATION (ОБЯЗАТЕЛЬНО) ---
# Провайдер и модели для chat-запросов
AI_PROVIDER=polza
AI_MODEL=claude-haiku-4.5
AI_MODEL_MINI=gpt-5-mini

# Отдельный провайдер и модель для embeddings
# Если не указать, используются polza и text-embedding-3-large
AI_EMBEDDING_PROVIDER=polza
AI_EMBEDDING_MODEL=text-embedding-3-large

# Ключи для провайдеров (заполните тот, который выбрали выше)
AI_TOKEN1=your_proxyapi_token_here

# --- 3. OPTIONAL SERVICES (ОПЦИОНАЛЬНО) ---
# Оставьте эти поля пустыми, если не планируете использовать функции погоды, 
# поиска или уведомлений в Telegram.

# Погода (API ключ от OpenWeatherMap)
WEATHER_API=

# Поиск в интернете (API ключ от Tavily)
SEARCH_API=

# Мониторинг в Telegram (Токен бота и ID вашего чата)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
