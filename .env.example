# =================================================================
# Пример файла переменных окружения для Discord Bot AI
# Скопируйте этот файл в .env и замените значения-заглушки своими.
# Не публикуйте файл .env и не добавляйте его в репозиторий.
# =================================================================

# -----------------------------------------------------------------
# Discord
# -----------------------------------------------------------------
# Токен бота из Discord Developer Portal.
DC_TOKEN=your_discord_token_here

# -----------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------
# Строка подключения к PostgreSQL через драйвер asyncpg.
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:pass@localhost:5432/discord
# Имя схемы PostgreSQL. При пустом значении используется схема по умолчанию
# для базы данных, обычно public.
DATABASE_SCHEMA=public

# -----------------------------------------------------------------
# AI API: чат
# -----------------------------------------------------------------
# Имя провайдера для chat-моделей.
AI_PROVIDER=your_chat_provider
# URL API для chat-моделей.
AI_API_URL=https://api.example/v1
# Основная chat-модель. Обязательна для завершённой конфигурации.
AI_MODEL=your_chat_model_here
# Дополнительная облегчённая модель. Также обязательна для завершённой конфигурации.
AI_MODEL_MINI=your_mini_model_here
# API-ключ для chat-моделей.
AI_TOKEN=your_chat_token_here

# -----------------------------------------------------------------
# Embeddings: векторные представления для памяти бота
# -----------------------------------------------------------------
# Имя провайдера для embeddings. Если не задано, используется AI_PROVIDER.
AI_EMBEDDING_PROVIDER=your_embedding_provider
# URL API для embedding-модели. Если не задан, используется AI_API_URL.
AI_EMBEDDING_API_URL=https://embedding.example/v1
# Embedding-модель. Обязательна для использования памяти и завершённой конфигурации.
AI_EMBEDDING_MODEL=your_embedding_model_here
# API-ключ для embeddings. Может совпадать с AI_TOKEN при использовании одного провайдера.
AI_EMBEDDING_TOKEN=your_embedding_token_here
